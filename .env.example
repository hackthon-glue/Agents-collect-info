# Agent Configuration
AGENT_MODEL_ID=amazon.nova-premier-v1:0
AGENT_ID=strands-data-pipeline
AGENT_NAME=Strands Data Pipeline Agent
LOG_LEVEL=INFO

# Deployment Configuration
ENVIRONMENT=development
VERSION=1.0.0

# Pipeline Configuration
PIPELINE_COUNTRIES=us,jp,uk
PIPELINE_COLLECT_NEWS=true
PIPELINE_COLLECT_WEATHER=true
PIPELINE_COLLECT_WEB_DATA=false
PIPELINE_NEWS_CATEGORY=general
PIPELINE_STORE_IN_DATABASE=true
PIPELINE_STORE_IN_S3=true
PIPELINE_ENABLE_FAKE_NEWS_FILTER=false
PIPELINE_ENABLE_SENTIMENT_ANALYSIS=false
PIPELINE_FAKE_NEWS_THRESHOLD=0.7
PIPELINE_USE_AI_CATEGORIZATION=false
PIPELINE_PRIMARY_COUNTRY=us

# API Configuration
NEWS_API_KEY=your_news_api_key_here
WEATHER_API_KEY=your_weather_api_key_here
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60
API_REQUEST_TIMEOUT=30

# AWS Configuration
AWS_REGION=us-east-1

# Database Configuration
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=strands_data
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_SSL_MODE=require
DB_CONNECTION_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30

# S3 Configuration
S3_BUCKET_NAME=your_s3_bucket_name
S3_REGION=us-east-1
S3_PREFIX_TEMPLATE={country}/{year}/{month}/{day}/{source_name}/
S3_ENABLE_VERSIONING=true
S3_ENABLE_ENCRYPTION=true

# Knowledge Base Configuration
KNOWLEDGE_BASE_ID=
DATA_SOURCE_ID=
KNOWLEDGE_BASE_OPENSEARCH_ENDPOINT=
KNOWLEDGE_BASE_INDEX_NAME=strands-data
KNOWLEDGE_BASE_ENABLE_SYNC=true
KNOWLEDGE_BASE_SYNC_ON_UPLOAD=true
KNOWLEDGE_BASE_MAX_SYNC_RETRIES=3

# SageMaker Configuration
SAGEMAKER_FAKE_NEWS_ENDPOINT=
SAGEMAKER_REGION=us-east-1
SAGEMAKER_FAKE_NEWS_THRESHOLD=0.7
SAGEMAKER_REQUEST_TIMEOUT=30

# Monitoring Configuration
MONITORING_ENABLE_METRICS=true
MONITORING_METRICS_NAMESPACE=StrandsAgent
MONITORING_LOG_RETENTION_DAYS=30