# Agent Configuration
AGENT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
STRANDS_LOG_LEVEL=INFO
STRANDS_CONFIG_FILE=config.json

# API Keys
NEWS_API_KEY=your_news_api_key_here
WEATHER_API_KEY=your_weather_api_key_here

# Database Configuration
DB_READER_ENDPOINT=your_db_reader_endpoint
DB_WRITER_ENDPOINT=your_db_writer_endpoint
DB_PORT=5432
DB_NAME=strands_data
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name
S3_REGION=us-east-1

# Knowledge Base Configuration
KNOWLEDGE_BASE_ID=your_knowledge_base_id
DATA_SOURCE_ID=your_data_source_id
BEDROCK_KB_ENDPOINT=your_knowledgebases_endpoint
OPENSEARCH_ENDPOINT=your_opensearch_endpoint

# SageMaker Configuration (for fake news filtering)
SAGEMAKER_FAKE_NEWS_ENDPOINT=your_sagemaker_endpoint

# Optional: Override default configuration file path
# STRANDS_CONFIG_FILE=/path/to/your/config.json