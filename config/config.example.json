{
  "agent_id": "strands-data-pipeline",
  "agent_name": "Strands Data Pipeline Agent",
  "log_level": "INFO",
  
  "pipeline": {
    "countries": ["us", "jp", "uk"],
    "collect_news": true,
    "collect_weather": true,
    "collect_web_data": false,
    "news_category": "general",
    "store_in_database": true,
    "store_in_s3": true,
    "enable_fake_news_filter": false,
    "enable_sentiment_analysis": false,
    "fake_news_threshold": 0.7,
    "use_ai_categorization": false,
    "primary_country": "us"
  },
  
  "apis": {
    "rate_limit_requests_per_minute": 60,
    "request_timeout": 30
  },
  
  "database": {
    "port": 5432,
    "database": "strands_data",
    "ssl_mode": "require",
    "connection_pool_size": 10,
    "connection_timeout": 30
  },
  
  "s3": {
    "region": "us-east-1",
    "prefix_template": "{country}/{year}/{month}/{day}/{source_name}/",
    "enable_versioning": true,
    "enable_encryption": true
  },
  
  "knowledge_base": {
    "knowledge_base_id": "arn:aws:bedrock:us-east-1:123456789012:knowledge-base/KB123456",
    "data_source_id": "DS123456",
    "opensearch_endpoint": "https://search-strands-abc123.us-east-1.es.amazonaws.com",
    "index_name": "strands-data",
    "enable_sync": true,
    "sync_on_upload": true,
    "max_sync_retries": 3
  },
  
  "sagemaker": {
    "fake_news_endpoint": "arn:aws:sagemaker:us-east-1:123456789012:endpoint/fake-news-detector",
    "region": "us-east-1"
  },
  
  "monitoring": {
    "enable_metrics": true,
    "metrics_namespace": "StrandsAgent",
    "log_retention_days": 30
  }
}